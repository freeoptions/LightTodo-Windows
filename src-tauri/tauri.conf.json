{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LightTodo",
  "version": "0.1.0",
  "identifier": "com.freez.lighttodo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "LightTodo",
        "resizable": true,
        "minWidth": 400,
        "minHeight": 500,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "decorations": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
